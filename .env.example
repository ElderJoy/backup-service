DATABASE_URL=postgres://backup:backup@localhost:5432/backup_service
REDIS_URL=redis://localhost:6379
AMQP_URL=amqp://guest:guest@localhost:5672/%2f
JWT_SECRET=super-secret-change-me-in-production
RUST_LOG=backup_service=debug,tower_http=debug,sqlx=warn
LISTEN_ADDR=0.0.0.0:8080

# gRPC server address (backup-service hosts this for worker callbacks)
GRPC_LISTEN_ADDR=0.0.0.0:50051

# gRPC target (backup-worker connects to this address)
GRPC_TARGET=http://localhost:50051

# OpenTelemetry (optional — traces exported to Jaeger when set)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECS=60
